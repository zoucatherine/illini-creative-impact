# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables).

# Partner form destination. Any endpoint that accepts a JSON POST works; Formspree is the simplest
# (https://formspree.io/f/xxxxxxx). If missing, the form shows a "not connected yet" notice.
VITE_PARTNER_FORM_ENDPOINT=
# Optional: override where Join sign-ups go. Leave empty to use /api/join (Discord, below).
VITE_JOIN_FORM_ENDPOINT=
# Join sign-ups post to /api/join (api/join.js), which forwards to a Discord channel.
# Server-side secret. If empty, sign-ups fall back to DISCORD_PITCH_WEBHOOK.
DISCORD_JOIN_WEBHOOK=
# "Pitch an Idea" posts to /api/pitch (api/pitch.js), which forwards to a Discord channel.
# Server-side secret: set it in .env.local and in Vercel. No VITE_ prefix, so it is never bundled.
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_PITCH_WEBHOOK=

# Optional: public Google Calendar for the Events page.
VITE_GOOGLE_CALENDAR_API_KEY=
VITE_GOOGLE_CALENDAR_ID=
